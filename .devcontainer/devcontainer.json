{
  "name": "distributed-systems-hw0-java25",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    // Installs OpenJDK 25 + Maven inside the container.
    // If your devcontainer CLI/feature version doesn't recognize "25" yet,
    // switch this to "lts".
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "installMaven": true,
      "installGradle": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack"
      ]
    }
  },
  "postCreateCommand": "mvn -q -DskipTests package",
  "remoteUser": "vscode"
}
