{
  "name": "Replicated Log (Java 25)",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "runServices": ["devcontainer", "master", "secondary1", "secondary2"],
  "shutdownAction": "stopCompose",
  "forwardPorts": [8080, 8081, 8082],
  "portsAttributes": {
    "8080": { "label": "master" },
    "8081": { "label": "secondary1" },
    "8082": { "label": "secondary2" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack"
      ]
    }
  },
  "postCreateCommand": "mvn -q -f pom.xml package"
}
